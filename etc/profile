export CARGO_HOME=$XDG_DATA_HOME/cargo
export CODEX_HOME=$XDG_CONFIG_HOME/codex
export COWPATH=$XDG_CONFIG_HOME/cows:/usr/share/cows
export ELECTRUMDIR=$XDG_DATA_HOME/electrum
export GDBHISTFILE=$XDG_DATA_HOME/gdb/history
export GNUPGHOME=$XDG_DATA_HOME/gnupg
export GOMODCACHE=$XDG_CACHE_HOME/go/mod
export GOPATH=$XDG_DATA_HOME/go
export HISTFILE=$XDG_STATE_HOME/sh/history
export PYTHONPYCACHEPREFIX=$XDG_CACHE_HOME/python
export PYTHONUSERBASE=$XDG_DATA_HOME/python
export RLWRAP_HOME=$XDG_DATA_HOME/rlwrap
export RUSTUP_HOME=$XDG_DATA_HOME/rustup
export STACK_XDG=1

mkdir -p -m 700 "${HISTFILE%/*}" "${GDBHISTFILE%/*}"

for profile_bin in "$HOME/bin" "$HOME/usr/bin" "$GOPATH/bin" "$CARGO_HOME/bin"; do
    case ":$PATH:" in
        *":$profile_bin:"*) ;;
        *) PATH="$profile_bin${PATH:+:$PATH}" ;;
    esac
done
unset profile_bin
export PATH

export EDITOR=helix
